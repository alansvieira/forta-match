[
  {
    "WorkflowName": "FortaVolwassenen",
    "DisplayName": "Forta Volwassenen",
    "SortOrder": 1,
    "KnockoutRuleNames": ["LeeftijdCheck", "CrisisUitsluiting", "LocatieCheck"],
    "Rules": [
      {
        "RuleName": "LeeftijdCheck",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Patiënt jonger dan 18 jaar — jeugd-GGZ vereist",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.Age >= 18"
      },
      {
        "RuleName": "CrisisUitsluiting",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Crisisniveau risico — doorverwijzen naar crisisdienst",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.RiskLevel != \"crisis\""
      },
      {
        "RuleName": "LocatieCheck",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Buiten servicegebied Forta Volwassenen",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.Region == \"Utrecht\" OR extraction.Region == \"Noord-Holland\" OR extraction.Region == \"Zuid-Holland\" OR extraction.Region == \"Gelderland\" OR extraction.Region == \"Flevoland\""
      },
      {
        "RuleName": "DsmAanwezig",
        "SuccessEvent": "PASS",
        "ErrorMessage": "DSM-classificatie ontbreekt of onbekend",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.ProbableDsm != null AND extraction.ProbableDsm != \"\" AND extraction.ProbableDsm != \"unknown\""
      },
      {
        "RuleName": "GGZContextCheck",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Geen duidelijke GGZ-hulpvraag gedetecteerd",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.Symptoms != null AND extraction.Symptoms != \"\""
      }
    ]
  },
  {
    "WorkflowName": "DrBosman",
    "DisplayName": "DR BOSMAN",
    "SortOrder": 2,
    "KnockoutRuleNames": ["LeeftijdCheck", "CrisisUitsluiting", "LocatieCheck"],
    "Rules": [
      {
        "RuleName": "LeeftijdCheck",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Patiënt jonger dan 25 jaar — DR BOSMAN behandelt vanaf 25",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.Age >= 25"
      },
      {
        "RuleName": "CrisisUitsluiting",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Crisisniveau niet passend bij DR BOSMAN profiel",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.RiskLevel != \"crisis\""
      },
      {
        "RuleName": "SpecialismeMatch",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Hulpvraag niet passend bij specialisme DR BOSMAN (persoonlijkheid / psychosomatiek)",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "(extraction.ProbableDsm != null AND extraction.ProbableDsm.StartsWith(\"F6\")) OR (extraction.Symptoms != null AND (extraction.Symptoms.Contains(\"persoonlijkheid\") OR extraction.Symptoms.Contains(\"psychosomat\") OR extraction.Symptoms.Contains(\"borderline\") OR extraction.Symptoms.Contains(\"emotiereg\")))"
      },
      {
        "RuleName": "LocatieCheck",
        "SuccessEvent": "PASS",
        "ErrorMessage": "Buiten servicegebied DR BOSMAN",
        "RuleExpressionType": "LambdaExpression",
        "Expression": "extraction.Region == \"Utrecht\" OR extraction.Region == \"Noord-Holland\" OR extraction.Region == \"Zuid-Holland\""
      }
    ]
  },
